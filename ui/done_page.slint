import { Button, Palette } from "std-widgets.slint";
import { Card } from "card.slint";

export component DonePage inherits VerticalLayout {
    in-out property <string> output-path: "";

    callback open-output();
    callback reset();
    callback close-app();

    alignment: center;
    vertical-stretch: 1;

    Card {
        VerticalLayout {
            padding: 32px;
            spacing: 20px;
            alignment: center;

            // Success Checkmark Badge
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: #107c41;
                cross-axis-self-alignment: center;

                Path {
                    width: 28px;
                    height: 28px;
                    x: 14px;
                    y: 14px;
                    commands: "M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z";
                    fill: #ffffff;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: "Collage Generated Successfully!";
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }

                Text {
                    text: "Your collage has been rendered and saved to disk.";
                    font-size: 13px;
                    horizontal-alignment: center;
                    color: Palette.foreground.transparentize(0.35);
                }
            }

            // Destination Info Box
            Rectangle {
                background: Palette.alternate-background;
                border-color: Palette.border;
                border-width: 1px;
                border-radius: 6px;

                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;

                    Text {
                        text: "Destination:";
                        font-size: 11px;
                        font-weight: 600;
                        color: Palette.foreground.transparentize(0.3);
                    }

                    Text {
                        text: root.output-path;
                        font-size: 12px;
                        color: Palette.foreground;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Button {
                    text: "Open Folder";
                    clicked => { root.open-output(); }
                }

                Button {
                    text: "Create Another";
                    primary: true;
                    clicked => { root.reset(); }
                }

                Button {
                    text: "Exit";
                    clicked => { root.close-app(); }
                }
            }
        }
    }
}
