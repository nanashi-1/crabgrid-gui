import { Button, Palette } from "std-widgets.slint";
import { Card } from "card.slint";

export component ErrorPage inherits VerticalLayout {
    in-out property <string> error-message: "";

    callback reset();
    callback close-app();

    alignment: center;
    vertical-stretch: 1;

    Card {
        VerticalLayout {
            padding: 32px;
            spacing: 20px;
            alignment: center;

            // Error Badge
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: #c42b1c;
                cross-axis-self-alignment: center;

                Path {
                    width: 26px;
                    height: 26px;
                    x: 15px;
                    y: 15px;
                    commands: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z";
                    fill: #ffffff;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: "An Error Occurred";
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }

                Text {
                    text: "Failed to compile the collage with the specified options.";
                    font-size: 13px;
                    horizontal-alignment: center;
                    color: Palette.foreground.transparentize(0.35);
                }
            }

            // Error Details Box
            Rectangle {
                background: Palette.alternate-background;
                border-color: #c42b1c40;
                border-width: 1px;
                border-radius: 6px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    Text {
                        text: "Error Details:";
                        font-size: 11px;
                        font-weight: 600;
                        color: #c42b1c;
                    }

                    Text {
                        text: root.error-message;
                        font-size: 12px;
                        color: Palette.foreground;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Button {
                    text: "Back to Settings";
                    primary: true;
                    clicked => { root.reset(); }
                }

                Button {
                    text: "Exit";
                    clicked => { root.close-app(); }
                }
            }
        }
    }
}
